<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medicamento_form" model="ir.ui.view">
        <field name="name">medicamento.form</field>
        <field name="model">medicamento</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="descripcion"/>
                        <field name="estado" widget="medicamento_widget"/>
                        <field name="precio"/>
                        <field name="stock"/>
                        <field name="fecha_expiracion"/>
                        <field name="caducidad"/> <!-- Nuevo Campo -->
                        <field name="es_alergico"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="medicamento_action" model="ir.actions.act_window">
        <field name="name">Medicamentos</field>
        <field name="res_model">medicamento</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="medicamento_menu" name="Medicamentos" sequence="10"/>
    <menuitem id="medicamento_submenu" parent="medicamento_menu" name="Gestión de Medicamentos" action="medicamento_action"/>
</odoo>
